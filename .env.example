# Create a bot with Telegram's official BotFather, then place the token here.
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_TOKEN

# Numeric Telegram user ID of the primary owner (not a username).
OWNER_ID=123456789

# Local development uses SQLite. Railway production should use its PostgreSQL DATABASE_URL.
DATABASE_URL=sqlite+aiosqlite:///./smart_exam_bot.db

# Optional. When supplied, Aiogram FSM states use Redis.
REDIS_URL=

# Current release supports polling. Webhook is reserved for a future deployment mode.
BOT_MODE=polling
LOG_LEVEL=INFO
PORT=8080
APP_VERSION=1.0.0
MAX_QUESTIONS=100
MAX_EXAM_DURATION_MINUTES=240
